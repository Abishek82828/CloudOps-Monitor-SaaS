# AWS Configuration
AWS_REGION=ap-south-1
DDB_TABLE=cloudops_metrics
# Replace with your own Topic ARN
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:cloudops-alerts

# Agent Configuration
HOST_ID=ec2-docker-host-01
INGEST_URL=http://api:8000/ingest
POLL_SECONDS=15

# Thresholds
CPU_THRESHOLD=85
MEM_THRESHOLD=85
DISK_THRESHOLD=90
ALERT_COOLDOWN_SECONDS=300
